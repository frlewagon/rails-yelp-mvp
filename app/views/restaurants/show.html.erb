<%= "Detailed infos about #{@restaurant.name}" %>

<div class="card" style="width: 36rem;">
  <div class="card-body">
    <h5 class="card-title"><%= @restaurant.name %></h5>
    <h6 class="card-subtitle mb-2 text-body-secondary"><%="Category: #{@restaurant.category}" %></h6>
    <p class="card-text"><%= "Address: #{@restaurant.address}" %></p>
    <% @restaurant.reviews.each do |review| %>
      <p class="card-text"><%= review.content %></p>
      <p class="card-text"><%= "Rating: #{review.rating} /5" %></p>
    <% end %>
    <a href="#" class="card-link">website</a>
    <a href="#" class="card-link">instagram</a>
  </div>
</div>
<div class="mt-3">
  <h2>Add a review</h2>
</div>

<%= render "reviews/reviewform", restaurant:@restaurant, review: @review %>

<%= link_to "Back to the list", restaurants_path, class: "btn btn-primary mt-3"  %>
