<h1>List of restaurants</h1>

<ol class="list-group list-group-numbered">
  <% @restaurants.each do |restaurant| %>
  <li class="list-group-item d-flex justify-content-between align-items-start">
    <div class="ms-2 me-auto">
      <div class="fw-bold"><%= link_to restaurant.name, restaurant_path(restaurant)  %></div>
    </div>
    <span class="badge text-bg-primary rounded-pill"><%= restaurant.reviews.length %></span>
  </li>
  <% end %>
</ol>

<div class="mt-3">
<%= link_to "Add a new Restaurant", new_restaurant_path, class: "btn btn-primary"  %>
</div>
